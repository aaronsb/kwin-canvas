<ui version="4.0">
 <class>KWinCanvasConfigForm</class>
 <widget class="QWidget" name="KWinCanvasConfigForm">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QGroupBox" name="group0"><property name="title"><string>Opening</string></property>
    <layout class="QFormLayout" name="form0">
     <item row="0" column="0"><widget class="QLabel" name="label_OpenZoom"><property name="text"><string>View when opened (fit, 1, or a zoom like 0.5)</string></property><property name="buddy"><cstring>kcfg_OpenZoom</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="kcfg_OpenZoom"/></item>
     <item row="1" column="0"><widget class="QLabel" name="label_HudPosition"><property name="text"><string>Toolbar position on the primary display</string></property><property name="buddy"><cstring>kcfg_HudPosition</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="kcfg_HudPosition"/></item>
     <item row="2" column="0"><widget class="QLabel" name="label_HudShape"><property name="text"><string>Toolbar shape (auto, horizontal, vertical, square)</string></property><property name="buddy"><cstring>kcfg_HudShape</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="kcfg_HudShape"/></item>
     <item row="3" column="0"><widget class="QLabel" name="label_Palette"><property name="text"><string>Activity colours (default, okabe-ito, tol, ibm, mono)</string></property><property name="buddy"><cstring>kcfg_Palette</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QLineEdit" name="kcfg_Palette"/></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="group1"><property name="title"><string>Keys inside the canvas (Qt key names, comma separated)</string></property>
    <layout class="QFormLayout" name="form1">
     <item row="0" column="0"><widget class="QLabel" name="label_KeyApply"><property name="text"><string>Apply and close</string></property><property name="buddy"><cstring>kcfg_KeyApply</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="kcfg_KeyApply"/></item>
     <item row="1" column="0"><widget class="QLabel" name="label_KeyCancel"><property name="text"><string>Cancel</string></property><property name="buddy"><cstring>kcfg_KeyCancel</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="kcfg_KeyCancel"/></item>
     <item row="2" column="0"><widget class="QLabel" name="label_KeyHome"><property name="text"><string>Look through frames</string></property><property name="buddy"><cstring>kcfg_KeyHome</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="kcfg_KeyHome"/></item>
     <item row="3" column="0"><widget class="QLabel" name="label_KeyOrigin"><property name="text"><string>Camera to origin</string></property><property name="buddy"><cstring>kcfg_KeyOrigin</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QLineEdit" name="kcfg_KeyOrigin"/></item>
     <item row="4" column="0"><widget class="QLabel" name="label_KeyFit"><property name="text"><string>Zoom to fit</string></property><property name="buddy"><cstring>kcfg_KeyFit</cstring></property></widget></item>
     <item row="4" column="1"><widget class="QLineEdit" name="kcfg_KeyFit"/></item>
     <item row="5" column="0"><widget class="QLabel" name="label_KeyZoomIn"><property name="text"><string>Zoom in</string></property><property name="buddy"><cstring>kcfg_KeyZoomIn</cstring></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="kcfg_KeyZoomIn"/></item>
     <item row="6" column="0"><widget class="QLabel" name="label_KeyZoomOut"><property name="text"><string>Zoom out</string></property><property name="buddy"><cstring>kcfg_KeyZoomOut</cstring></property></widget></item>
     <item row="6" column="1"><widget class="QLineEdit" name="kcfg_KeyZoomOut"/></item>
     <item row="7" column="0"><widget class="QLabel" name="label_KeyPan"><property name="text"><string>Hold to pan from anywhere</string></property><property name="buddy"><cstring>kcfg_KeyPan</cstring></property></widget></item>
     <item row="7" column="1"><widget class="QLineEdit" name="kcfg_KeyPan"/></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="group2"><property name="title"><string>Mouse gestures (Click or DoubleClick, with Shift+, Ctrl+, Alt+, Meta+)</string></property>
    <layout class="QFormLayout" name="form2">
     <item row="0" column="0"><widget class="QLabel" name="label_MouseFocusWindow"><property name="text"><string>On a window: apply focused on it</string></property><property name="buddy"><cstring>kcfg_MouseFocusWindow</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="kcfg_MouseFocusWindow"/></item>
     <item row="1" column="0"><widget class="QLabel" name="label_MouseZoomToActivity"><property name="text"><string>On a frame: zoom to that activity</string></property><property name="buddy"><cstring>kcfg_MouseZoomToActivity</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="kcfg_MouseZoomToActivity"/></item>
     <item row="2" column="0"><widget class="QLabel" name="label_MouseGotoActivity"><property name="text"><string>On a frame: apply with that activity current</string></property><property name="buddy"><cstring>kcfg_MouseGotoActivity</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="kcfg_MouseGotoActivity"/></item>
     <item row="4" column="0"><widget class="QLabel" name="label_MouseSelect"><property name="text"><string>On a window: select it alone</string></property><property name="buddy"><cstring>kcfg_MouseSelect</cstring></property></widget></item>
     <item row="4" column="1"><widget class="QLineEdit" name="kcfg_MouseSelect"/></item>
     <item row="5" column="0"><widget class="QLabel" name="label_MouseSelectAdd"><property name="text"><string>On a window: add to selection (its modifier + drag on ground: rectangle select)</string></property><property name="buddy"><cstring>kcfg_MouseSelectAdd</cstring></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="kcfg_MouseSelectAdd"/></item>
     <item row="6" column="0"><widget class="QLabel" name="label_MouseSelectToggle"><property name="text"><string>On a window: toggle selection</string></property><property name="buddy"><cstring>kcfg_MouseSelectToggle</cstring></property></widget></item>
     <item row="6" column="1"><widget class="QLineEdit" name="kcfg_MouseSelectToggle"/></item>
     <item row="7" column="0"><widget class="QLabel" name="label_MouseContextMenu"><property name="text"><string>On a window: arrange menu for the selection</string></property><property name="buddy"><cstring>kcfg_MouseContextMenu</cstring></property></widget></item>
     <item row="7" column="1"><widget class="QLineEdit" name="kcfg_MouseContextMenu"/></item>
     <item row="9" column="1"><widget class="QCheckBox" name="kcfg_FramesCarryWindows"><property name="text"><string>Dragging an activity's frames carries its windows along</string></property></widget></item>
     <item row="8" column="0"><widget class="QLabel" name="label_FocusTarget"><property name="text"><string>Double-click target: window (clicked point under the pointer) or desktop (a frame stays put)</string></property><property name="buddy"><cstring>kcfg_FocusTarget</cstring></property></widget></item>
     <item row="8" column="1"><widget class="QLineEdit" name="kcfg_FocusTarget"/></item>
     <item row="3" column="0"><widget class="QLabel" name="label_MouseNewActivityAt"><property name="text"><string>On a window outside every frame: new activity there</string></property><property name="buddy"><cstring>kcfg_MouseNewActivityAt</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QLineEdit" name="kcfg_MouseNewActivityAt"/></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="group3"><property name="title"><string>Default global chords (rebind under Shortcuts > KWin)</string></property>
    <layout class="QFormLayout" name="form3">
     <item row="0" column="0"><widget class="QLabel" name="label_ToggleShortcut"><property name="text"><string>Open or close the canvas</string></property><property name="buddy"><cstring>kcfg_ToggleShortcut</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="kcfg_ToggleShortcut"/></item>
     <item row="1" column="0"><widget class="QLabel" name="label_HomeShortcut"><property name="text"><string>Return this activity to the origin</string></property><property name="buddy"><cstring>kcfg_HomeShortcut</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="kcfg_HomeShortcut"/></item>
     <item row="2" column="0"><widget class="QLabel" name="label_PanLeftShortcut"><property name="text"><string>Pan left one step</string></property><property name="buddy"><cstring>kcfg_PanLeftShortcut</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="kcfg_PanLeftShortcut"/></item>
     <item row="3" column="0"><widget class="QLabel" name="label_PanRightShortcut"><property name="text"><string>Pan right one step</string></property><property name="buddy"><cstring>kcfg_PanRightShortcut</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QLineEdit" name="kcfg_PanRightShortcut"/></item>
     <item row="4" column="0"><widget class="QLabel" name="label_PanUpShortcut"><property name="text"><string>Pan up one step</string></property><property name="buddy"><cstring>kcfg_PanUpShortcut</cstring></property></widget></item>
     <item row="4" column="1"><widget class="QLineEdit" name="kcfg_PanUpShortcut"/></item>
     <item row="5" column="0"><widget class="QLabel" name="label_PanDownShortcut"><property name="text"><string>Pan down one step</string></property><property name="buddy"><cstring>kcfg_PanDownShortcut</cstring></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="kcfg_PanDownShortcut"/></item>
     <item row="6" column="0"><widget class="QLabel" name="label_PanModeShortcut"><property name="text"><string>Hold to pan the desktop with the mouse</string></property><property name="buddy"><cstring>kcfg_PanModeShortcut</cstring></property></widget></item>
     <item row="6" column="1"><widget class="QLineEdit" name="kcfg_PanModeShortcut"/></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="groupPan"><property name="title"><string>Panning at 1:1</string></property>
    <layout class="QFormLayout" name="formPan">
     <item row="0" column="0"><widget class="QLabel" name="label_PanStep"><property name="text"><string>Step, as a fraction of the screen</string></property><property name="buddy"><cstring>kcfg_PanStep</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QDoubleSpinBox" name="kcfg_PanStep"><property name="minimum"><double>0.05</double></property><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.05</double></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="label_PanDuration"><property name="text"><string>Slide duration (ms, 0 jumps)</string></property><property name="buddy"><cstring>kcfg_PanDuration</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QSpinBox" name="kcfg_PanDuration"><property name="minimum"><number>0</number></property><property name="maximum"><number>2000</number></property></widget></item>
     <item row="3" column="1"><widget class="QCheckBox" name="kcfg_PanModePassthrough"><property name="text"><string>Pass clicks and wheel through to windows in pan mode (needs the kwin-canvas-passthrough plugin)</string></property></widget></item>
     <item row="2" column="0"><widget class="QLabel" name="label_PanSwipeFingers"><property name="text"><string>Touchpad swipe fingers (0 off; 3 and 4 also fire KWin's own swipes)</string></property><property name="buddy"><cstring>kcfg_PanSwipeFingers</cstring></property></widget></item>
     <item row="2" column="1"><widget class="QSpinBox" name="kcfg_PanSwipeFingers"><property name="minimum"><number>0</number></property><property name="maximum"><number>5</number></property></widget></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="group4"><property name="title"><string>Ground</string></property>
    <layout class="QFormLayout" name="form4">
     <item row="0" column="0"><widget class="QLabel" name="label_GridBase"><property name="text"><string>Minor grid spacing (px)</string></property><property name="buddy"><cstring>kcfg_GridBase</cstring></property></widget></item>
     <item row="0" column="1"><widget class="QSpinBox" name="kcfg_GridBase"><property name="minimum"><number>8</number></property><property name="maximum"><number>1024</number></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="label_TileImage"><property name="text"><string>Tile image (file URL, empty for the grid)</string></property><property name="buddy"><cstring>kcfg_TileImage</cstring></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="kcfg_TileImage"/></item>
    </layout></widget></item>
   <item><widget class="QGroupBox" name="groupSnap"><property name="title"><string>Snapping while dragging</string></property>
    <layout class="QFormLayout" name="formSnap">
     <item row="0" column="1"><widget class="QCheckBox" name="kcfg_SnapEdges"><property name="text"><string>Snap to edges of other windows and frames</string></property></widget></item>
     <item row="1" column="1"><widget class="QCheckBox" name="kcfg_SnapCorners"><property name="text"><string>Snap to corners</string></property></widget></item>
     <item row="2" column="1"><widget class="QCheckBox" name="kcfg_SnapGrid"><property name="text"><string>Snap to the canvas grid</string></property></widget></item>
     <item row="3" column="0"><widget class="QLabel" name="label_SnapGridSize"><property name="text"><string>Grid step (px)</string></property><property name="buddy"><cstring>kcfg_SnapGridSize</cstring></property></widget></item>
     <item row="3" column="1"><widget class="QSpinBox" name="kcfg_SnapGridSize"><property name="minimum"><number>4</number></property><property name="maximum"><number>1024</number></property></widget></item>
     <item row="4" column="0"><widget class="QLabel" name="label_SnapDistance"><property name="text"><string>Snap distance (screen px)</string></property><property name="buddy"><cstring>kcfg_SnapDistance</cstring></property></widget></item>
     <item row="4" column="1"><widget class="QSpinBox" name="kcfg_SnapDistance"><property name="minimum"><number>1</number></property><property name="maximum"><number>64</number></property></widget></item>
    </layout></widget></item>
   <item><spacer name="spacer"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
  </layout>
 </widget>
 <resources/><connections/>
</ui>
